# --- CONFIGURACIÓN DE LLM (GOOGLE GEMINI) ---
GOOGLE_API_KEY=pegar_aqui_la_api_key_temporal_de_gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# --- CONFIGURACIÓN DE EMBEDDINGS Y CHROMADB ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=ic7_internal_docs
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- CONFIGURACIÓN DE ALMACENAMIENTO (LOCAL / AWS S3) ---
#USE_S3=False
LOCAL_DOCS_DIR=./data/docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=ic7-rag-documents-bucket